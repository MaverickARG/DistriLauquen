# ═══════════════════════════════════════════════════════════════
# Archivo de Configuración de Ejemplo - DistriLauquen
# ═══════════════════════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus valores reales
# 3. NUNCA commits .env a tu repositorio de Git
# 4. Asegúrate de que .env esté en .gitignore
#
# ═══════════════════════════════════════════════════════════════

# --- CONFIGURACIÓN DEL SERVIDOR ---
# Puerto en el que corre el backend
PORT=3001

# URL del frontend (para CORS y reset de contraseña)
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# --- AUTENTICACIÓN Y SEGURIDAD (CRÍTICO) ---
# ═══════════════════════════════════════════════════════════════

# JWT Secret para tokens de autenticación
# DEBE SER AL MENOS 32 CARACTERES ALEATORIOS
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_at_least_32_characters_here

# JWT Secret para tokens de restablecimiento de contraseña
# DEBE SER DIFERENTE a JWT_SECRET
JWT_RESET_SECRET=your_very_long_random_jwt_reset_secret_at_least_32_characters_here

# Credenciales del administrador (opcional)
# Si no se especifican, se genera una contraseña fuerte automáticamente
# ADMIN_USERNAME=Dlauquen
# ADMIN_PASSWORD=GeneratedAutomaticallyIfNotProvided
# ADMIN_EMAIL=admin@distrilauquen.com

# ═══════════════════════════════════════════════════════════════
# --- CONFIGURACIÓN DE EMAIL ---
# ═══════════════════════════════════════════════════════════════

# Para testing, puedes usar Ethereal (https://ethereal.email/)
# Recibirás credenciales por email después del primer uso

# SMTP Host (servidor de correo saliente)
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP
# 587 para TLS (recomendado)
# 465 para SSL
EMAIL_PORT=587

# Email del remitente
EMAIL_USER=tu-email@gmail.com

# Contraseña del email (considera usar contraseña de aplicación en Gmail)
EMAIL_PASS=your-email-password

# Email desde el que se envían los correos
EMAIL_FROM=noreply@distrilauquen.com

# ═══════════════════════════════════════════════════════════════
# --- CONFIGURACIÓN DE BASE DE DATOS ---
# ═══════════════════════════════════════════════════════════════

# SQLite usa un archivo local (backend/data/users.sqlite)
# No se requiere configuración adicional

# Para producción, considera migrar a PostgreSQL o MySQL
# DATABASE_URL=postgresql://user:password@localhost:5432/distrilauquen

# ═══════════════════════════════════════════════════════════════
# NOTAS DE SEGURIDAD:
# ═══════════════════════════════════════════════════════════════
# 
# 1. Genera secretos fuertes:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# 2. Usa contraseñas de aplicación en lugar de contraseña real de Gmail:
#    https://support.google.com/accounts/answer/185833
# 
# 3. En producción:
#    - Usa HTTPS obligatoriamente
#    - Guarda variables de entorno en el panel de Vercel/Render
#    - Nunca expongas .env en públicamente
#    - Rota secretos regularmente
# 
# 4. Contraseña de admin:
#    - Si no se especifica, se genera automáticamente
#    - Se muestra UNA SOLA VEZ en los logs al iniciar
#    - COPIA Y GUARDA EN UN LUGAR SEGURO
#    - Cámbiala después del primer login
#
# ═══════════════════════════════════════════════════════════════
